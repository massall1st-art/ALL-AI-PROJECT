<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ALL AI — WhatsApp Assistant</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cyber: {
              black: '#05070a',
              dark: '#0a0f14',
              card: 'rgba(13, 22, 28, 0.75)',
              border: '#112921',
              neon: '#00ff88',
              emerald: '#059669',
              darkgreen: '#022c22',
              glow: '#00ff88',
            }
          },
          fontFamily: {
            mono: ['Fira Code', 'JetBrains Mono', 'monospace'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          animation: {
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'spin-slow': 'spin 12s linear infinite',
            'glow-pulse': 'glowPulse 2s infinite ease-in-out',
            'float': 'float 4s ease-in-out infinite',
          },
          keyframes: {
            glowPulse: {
              '0%, 100%': { boxShadow: '0 0 15px rgba(0,255,136,0.3), inset 0 0 10px rgba(0,255,136,0.2)' },
              '50%': { boxShadow: '0 0 30px rgba(0,255,136,0.7), inset 0 0 20px rgba(0,255,136,0.4)' },
            },
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-8px)' },
            }
          }
        }
      }
    }
  </script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Three.js for 3D Background -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Marked.js for Markdown Processing -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- Highlight.js for Code Highlighting -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>

  <style>
    :root {
      --cyber-color: #00ff88;
      --cyber-color-dark: #022c22;
      --cyber-glow: rgba(0, 255, 136, 0.4);
      --cyber-glow-heavy: rgba(0, 255, 136, 0.7);
      --cyber-border: rgba(0, 255, 136, 0.25);
    }

    .theme-pink {
      --cyber-color: #ff007f;
      --cyber-color-dark: #2c0218;
      --cyber-glow: rgba(255, 0, 127, 0.4);
      --cyber-glow-heavy: rgba(255, 0, 127, 0.7);
      --cyber-border: rgba(255, 0, 127, 0.25);
    }

    .theme-cyan {
      --cyber-color: #00f0ff;
      --cyber-color-dark: #02232c;
      --cyber-glow: rgba(0, 240, 255, 0.4);
      --cyber-glow-heavy: rgba(0, 240, 255, 0.7);
      --cyber-border: rgba(0, 240, 255, 0.25);
    }

    .theme-amber {
      --cyber-color: #ffaa00;
      --cyber-color-dark: #2c1a02;
      --cyber-glow: rgba(255, 170, 0, 0.4);
      --cyber-glow-heavy: rgba(255, 170, 0, 0.7);
      --cyber-border: rgba(255, 170, 0, 0.25);
    }

    .theme-purple {
      --cyber-color: #a855f7;
      --cyber-color-dark: #1d022c;
      --cyber-glow: rgba(168, 85, 247, 0.4);
      --cyber-glow-heavy: rgba(168, 85, 247, 0.7);
      --cyber-border: rgba(168, 85, 247, 0.25);
    }

    /* Dynamic CSS Color Override */
    .text-cyber-neon { color: var(--cyber-color) !important; }
    .bg-cyber-neon { background-color: var(--cyber-color) !important; }
    .border-cyber-neon { border-color: var(--cyber-color) !important; }
    .border-cyber-neon\/40 { border-color: var(--cyber-border) !important; }

    /* Custom Scrollbar Styling */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #05070a;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--cyber-color-dark);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--cyber-color);
    }

    /* Glassmorphism Styles */
    .glass-card {
      background: rgba(10, 18, 22, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--cyber-border);
    }
    
    .glass-card-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card-hover:hover {
      border-color: var(--cyber-color);
      box-shadow: 0 0 20px var(--cyber-glow);
    }

    /* Cyberpunk Scanlines overlay toggle */
    .scanlines-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 5;
      background: linear-gradient(
        to bottom,
        rgba(255,255,255,0),
        rgba(255,255,255,0) 50%,
        rgba(0, 0, 0, 0.25) 50%,
        rgba(0, 0, 0, 0.25)
      );
      background-size: 100% 4px;
      opacity: 0.6;
    }

    /* Cyber Corner Frame Decorations */
    .cyber-hud-box {
      position: relative;
    }
    .cyber-hud-box::before, .cyber-hud-box::after {
      content: '';
      position: absolute;
      width: 8px;
      height: 8px;
      border-color: var(--cyber-color);
      pointer-events: none;
    }
    .cyber-hud-box::before {
      top: 0; left: 0;
      border-top: 2px solid var(--cyber-color);
      border-left: 2px solid var(--cyber-color);
    }
    .cyber-hud-box::after {
      bottom: 0; right: 0;
      border-bottom: 2px solid var(--cyber-color);
      border-right: 2px solid var(--cyber-color);
    }

    /* Avatar Neon Rotating Ring */
    .neon-ring-container {
      position: relative;
      display: inline-flex;
      justify-content: center;
      align-items: center;
    }

    .neon-ring {
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: conic-gradient(from 0deg, transparent 0%, var(--cyber-color) 50%, var(--cyber-color-dark) 80%, transparent 100%);
      animation: rotateRing 4s linear infinite;
      filter: blur(1px);
    }

    @keyframes rotateRing {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Canvas overlay gradient */
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
    }

    /* Markdown styling inside message bubbles */
    .markdown-content p {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }
    .markdown-content p:last-child {
      margin-bottom: 0;
    }
    .markdown-content code {
      background: var(--cyber-border);
      color: var(--cyber-color);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.9em;
    }
    .markdown-content pre {
      background: #060d11 !important;
      border: 1px solid var(--cyber-border);
      border-radius: 8px;
      padding: 0.75rem;
      margin: 0.75rem 0;
      overflow-x: auto;
      position: relative;
    }
    .markdown-content ul {
      list-style-type: disc;
      padding-left: 1.25rem;
      margin-bottom: 0.5rem;
    }
    .markdown-content ol {
      list-style-type: decimal;
      padding-left: 1.25rem;
      margin-bottom: 0.5rem;
    }
  </style>
</head>

<body class="bg-cyber-black text-gray-100 font-sans antialiased min-h-screen overflow-x-hidden selection:bg-cyber-neon selection:text-black transition-colors duration-500">

  <div id="scanlines" class="scanlines-overlay"></div>
  <div id="canvas-container"></div>

  <!-- Main Container -->
  <div id="app" class="relative z-10 min-h-screen flex flex-col justify-between">

    <header class="border-b border-emerald-900/40 glass-card sticky top-0 z-30 px-4 py-3">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        
        <!-- Brand & Profile Header -->
        <div class="flex items-center space-x-3 cursor-pointer" onclick="app.showLandingOrChat()">
          <div class="neon-ring-container w-10 h-10">
            <div class="neon-ring"></div>
            <img id="header-avatar" src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150&auto=format&fit=crop&q=80" alt="AI Avatar" class="w-10 h-10 rounded-full object-cover relative z-10 border border-cyber-black">
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h1 id="header-name" class="font-bold text-white tracking-wide text-base">ALL AI</h1>
              <span id="header-status-badge" class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-cyber-neon border border-cyber-neon/40">
                <span class="w-1.5 h-1.5 rounded-full bg-cyber-neon animate-pulse mr-1"></span>
                ONLINE
              </span>
            </div>
            <p id="header-desc" class="text-xs text-cyber-neon/80 truncate max-w-[180px] sm:max-w-xs">Your Smart WhatsApp Assistant</p>
          </div>
        </div>

        <!-- Header Controls with Quick Theme Switcher -->
        <div class="flex items-center space-x-2 relative">
          <!-- Cyber Theme Quick Picker Button -->
          <button onclick="app.toggleThemeDropdown()" title="Switch Cyberpunk 3D Theme" class="p-2 rounded-lg bg-emerald-950/60 border border-cyber-neon/40 text-cyber-neon hover:bg-cyber-neon hover:text-black transition shadow-[0_0_10px_var(--cyber-glow)]">
            <i class="fa-solid fa-palette text-sm"></i>
          </button>

          <!-- Cyberpunk Quick Theme Dropdown Menu -->
          <div id="theme-dropdown" class="hidden absolute top-12 right-12 w-52 glass-card rounded-xl p-2 z-50 border border-cyber-neon/50 shadow-2xl space-y-1 text-xs">
            <p class="text-[10px] uppercase font-mono text-cyber-neon px-2 py-1 border-b border-emerald-900/40">Cyber 3D Colors</p>
            <button onclick="app.setCyberTheme('green')" class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between hover:bg-emerald-950/70 text-emerald-400">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-[#00ff88]"></span> Matrix Green</span>
              <i class="fa-solid fa-check opacity-0 theme-chk-green"></i>
            </button>
            <button onclick="app.setCyberTheme('pink')" class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between hover:bg-emerald-950/70 text-pink-400">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-[#ff007f]"></span> Neon Pink</span>
              <i class="fa-solid fa-check opacity-0 theme-chk-pink"></i>
            </button>
            <button onclick="app.setCyberTheme('cyan')" class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between hover:bg-emerald-950/70 text-cyan-400">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-[#00f0ff]"></span> Electric Cyan</span>
              <i class="fa-solid fa-check opacity-0 theme-chk-cyan"></i>
            </button>
            <button onclick="app.setCyberTheme('amber')" class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between hover:bg-emerald-950/70 text-amber-400">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-[#ffaa00]"></span> Synthwave Amber</span>
              <i class="fa-solid fa-check opacity-0 theme-chk-amber"></i>
            </button>
            <button onclick="app.setCyberTheme('purple')" class="w-full text-left px-2.5 py-1.5 rounded-lg flex items-center justify-between hover:bg-emerald-950/70 text-purple-400">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-[#a855f7]"></span> Ultraviolet Void</span>
              <i class="fa-solid fa-check opacity-0 theme-chk-purple"></i>
            </button>

            <p class="text-[10px] uppercase font-mono text-cyber-neon px-2 py-1 mt-2 border-t border-b border-emerald-900/40">Mode Model 3D</p>
            <div class="grid grid-cols-2 gap-1 pt-1">
              <button onclick="app.set3DMode('knot')" class="text-left px-2 py-1.5 rounded hover:bg-emerald-950/80 text-[11px] text-gray-200 flex items-center gap-1.5">
                <i class="fa-solid fa-gem text-cyber-neon"></i> Knot
              </button>
              <button onclick="app.set3DMode('sphere')" class="text-left px-2 py-1.5 rounded hover:bg-emerald-950/80 text-[11px] text-gray-200 flex items-center gap-1.5">
                <i class="fa-solid fa-globe text-cyber-neon"></i> Sphere
              </button>
              <button onclick="app.set3DMode('cubes')" class="text-left px-2 py-1.5 rounded hover:bg-emerald-950/80 text-[11px] text-gray-200 flex items-center gap-1.5">
                <i class="fa-solid fa-cubes text-cyber-neon"></i> Cubes
              </button>
              <button onclick="app.set3DMode('warp')" class="text-left px-2 py-1.5 rounded hover:bg-emerald-950/80 text-[11px] text-gray-200 flex items-center gap-1.5">
                <i class="fa-solid fa-rocket text-cyber-neon"></i> Warp
              </button>
            </div>
          </div>

          <!-- Cyber Audio SFX Toggle -->
          <button id="btn-audio-toggle" onclick="app.toggleAudioSFX()" title="Toggle Cyber Sound Effects" class="p-2 rounded-lg bg-emerald-950/60 border border-cyber-neon/40 text-cyber-neon hover:bg-cyber-neon hover:text-black transition">
            <i class="fa-solid fa-volume-xmark text-sm"></i>
          </button>

          <!-- Cyber Developer Social Media Button -->
          <button onclick="app.openSocialsModal()" title="Media Sosial Developer" class="p-2 rounded-lg bg-emerald-950/60 border border-cyber-neon/40 text-cyber-neon hover:bg-cyber-neon hover:text-black transition shadow-[0_0_10px_var(--cyber-glow)]">
            <i class="fa-solid fa-share-nodes text-sm"></i>
          </button>

          <button id="btn-toggle-sidebar" onclick="app.toggleSidebar()" class="lg:hidden p-2 rounded-lg bg-emerald-950/60 border border-emerald-800/50 text-cyber-neon hover:bg-emerald-900/60 transition">
            <i class="fa-solid fa-bars"></i>
          </button>
          <button onclick="app.createNewChat()" title="New Chat" class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-emerald-950/70 border border-cyber-neon/40 text-cyber-neon hover:bg-cyber-neon hover:text-black transition text-xs font-semibold">
            <i class="fa-solid fa-plus"></i>
            <span>Chat Baru</span>
          </button>
          <button onclick="app.openAdminAuthModal()" title="Developer / Admin Panel" class="p-2 rounded-lg bg-emerald-950/60 border border-emerald-800/50 text-cyber-neon hover:bg-emerald-900/50 transition">
            <i class="fa-solid fa-user-gear"></i>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-grow flex relative max-w-7xl w-full mx-auto overflow-hidden">

      <!-- LANDING PAGE SECTION -->
      <section id="view-landing" class="w-full flex flex-col items-center justify-center p-6 text-center my-auto min-h-[80vh]">
        
        <div class="mb-4">
          <span class="inline-block bg-black/60 border border-cyber-neon text-cyber-neon text-xs px-3 py-1 rounded-full font-mono font-bold animate-pulse shadow-[0_0_12px_rgba(0,255,136,0.3)]">
            v2.5 Hybrid
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-200 to-cyber-neon tracking-tight mb-3">
          ALL AI
        </h1>
        <p class="text-cyber-neon font-mono text-sm sm:text-base tracking-widest uppercase mb-4">
          Smart AI Assistant
        </p>
        <p class="text-gray-400 max-w-md text-sm sm:text-base mb-8 leading-relaxed">
          Asisten cerdas serba bisa yang responsif, dibekali kemampuan coding, analisis data, pembuatan konten, dan pemecahan masalah secara terstruktur.
        </p>

        <!-- Feature Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl w-full mb-8">
          <div class="glass-card cyber-hud-box p-3 rounded-xl text-left border-emerald-900/50">
            <i class="fa-solid fa-code text-cyber-neon mb-1 text-lg"></i>
            <h3 class="text-xs font-bold text-white">Full Stack Code</h3>
            <p class="text-[11px] text-gray-400">HTML, JS, Python & logic</p>
          </div>
          <div class="glass-card cyber-hud-box p-3 rounded-xl text-left border-emerald-900/50">
            <i class="fa-solid fa-cube text-cyber-neon mb-1 text-lg"></i>
            <h3 class="text-xs font-bold text-white">3D Cyber Engine</h3>
            <p class="text-[11px] text-gray-400">Interaktif & Holografik</p>
          </div>
          <div class="glass-card cyber-hud-box p-3 rounded-xl text-left border-emerald-900/50">
            <i class="fa-solid fa-bolt text-cyber-neon mb-1 text-lg"></i>
            <h3 class="text-xs font-bold text-white">Respon Cepat</h3>
            <p class="text-[11px] text-gray-400">Sistem real-time ultra fast</p>
          </div>
          <div class="glass-card cyber-hud-box p-3 rounded-xl text-left border-emerald-900/50">
            <i class="fa-solid fa-shield-halved text-cyber-neon mb-1 text-lg"></i>
            <h3 class="text-xs font-bold text-white">Aman & Privat</h3>
            <p class="text-[11px] text-gray-400">Proses data terenkripsi</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-sm">
          <button onclick="app.startChatSession()" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-emerald-600 to-cyber-neon text-black font-bold tracking-wide hover:brightness-110 transition shadow-[0_0_25px_rgba(0,255,136,0.4)] flex items-center justify-center space-x-2">
            <i class="fa-solid fa-comments text-lg"></i>
            <span>START CHAT</span>
          </button>
          <button onclick="app.openAdminAuthModal()" class="w-full py-3.5 px-6 rounded-xl glass-card border border-cyber-neon/40 text-cyber-neon font-bold tracking-wide hover:bg-emerald-950/60 transition flex items-center justify-center space-x-2">
            <i class="fa-solid fa-terminal text-lg"></i>
            <span>DEVELOPER PANEL</span>
          </button>
        </div>

        <!-- Social Media Quick Bar on Landing Page -->
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-2">
          <span class="text-xs font-mono text-gray-400">Media Sosial Dev:</span>
          <div id="landing-social-links" class="flex items-center space-x-2">
            <!-- Dynamic Social Icons rendered via JS -->
          </div>
        </div>
      </section>

      <!-- CHAT & SIDEBAR SECTION -->
      <section id="view-chat" class="hidden w-full flex-grow flex overflow-hidden h-[calc(100vh-65px)]">

        <!-- Overlay backdrop for mobile drawer -->
        <div id="sidebar-backdrop" onclick="app.toggleSidebar()" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-20 hidden lg:hidden"></div>

        <aside id="chat-sidebar" class="fixed lg:static inset-y-0 left-0 z-20 w-72 bg-cyber-dark/95 border-r border-emerald-900/40 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
          
          <div class="p-4 border-b border-emerald-900/40 flex items-center justify-between">
            <button onclick="app.createNewChat()" class="w-full py-2.5 px-4 rounded-xl bg-emerald-950 border border-cyber-neon/40 text-cyber-neon hover:bg-cyber-neon hover:text-black font-semibold text-xs flex items-center justify-center space-x-2 transition shadow-[0_0_15px_rgba(0,255,136,0.15)]">
              <i class="fa-solid fa-plus"></i>
              <span>+ Chat Baru</span>
            </button>
          </div>

          <!-- History Chats List -->
          <div class="flex-1 overflow-y-auto p-3 space-y-1" id="chat-history-list">
            <!-- Dynamic elements will be inserted here -->
          </div>

          <!-- Sidebar Footer Controls -->
          <div class="p-3 border-t border-emerald-900/40 space-y-2 text-xs">
            <button onclick="app.clearCurrentChat()" class="w-full flex items-center space-x-2 px-3 py-2 rounded-lg text-gray-400 hover:text-red-400 hover:bg-red-950/30 transition">
              <i class="fa-solid fa-trash-can w-4"></i>
              <span>Bersihkan Chat Ini</span>
            </button>
            <button onclick="app.openAdminAuthModal()" class="w-full flex items-center space-x-2 px-3 py-2 rounded-lg text-gray-400 hover:text-cyber-neon hover:bg-emerald-950/40 transition">
              <i class="fa-solid fa-sliders w-4"></i>
              <span>Pengaturan Admin</span>
            </button>
            
            <div class="pt-2 border-t border-emerald-900/30 text-center space-y-2">
              <button onclick="app.openSocialsModal()" class="w-full py-1.5 px-3 rounded-lg bg-emerald-950/80 border border-cyber-neon/30 text-cyber-neon hover:bg-cyber-neon hover:text-black font-mono text-[11px] flex items-center justify-center gap-2 transition shadow-[0_0_10px_rgba(0,255,136,0.1)]">
                <i class="fa-solid fa-share-nodes"></i>
                <span>Sosial Media Developer</span>
              </button>
              <p class="text-[10px] uppercase font-mono tracking-wider text-cyber-neon/80 font-semibold drop-shadow-[0_0_8px_rgba(0,255,136,0.5)] cursor-pointer hover:underline" onclick="app.openSocialsModal()">
                DEVELOPER BY ALL STORE PROJECT
              </p>
            </div>
          </div>
        </aside>

        <div class="flex-1 flex flex-col h-full bg-cyber-black/50 relative overflow-hidden">

          <!-- Messages Container -->
          <div id="messages-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">

            <!-- Welcome Screen Card (Shown when conversation is empty) -->
            <div id="welcome-screen" class="max-w-xl mx-auto my-8 p-6 rounded-2xl glass-card text-center space-y-4">
              <div class="w-16 h-16 mx-auto rounded-full bg-emerald-950 border border-cyber-neon/50 flex items-center justify-center text-cyber-neon text-2xl shadow-[0_0_20px_rgba(0,255,136,0.2)]">
                <i class="fa-solid fa-robot"></i>
              </div>
