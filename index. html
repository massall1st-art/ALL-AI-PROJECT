  <script>
    let scene, camera, renderer, particles, gridHelper, active3DMeshGroup;
    let animFrameId = null;
    let is3DEnabled = true;
    let currentThemeHex = 0x00ff88;
    let currentThemeDarkHex = 0x022c22;
    let current3DMode = localStorage.getItem('all_ai_3d_mode') || 'knot';

    const CYBER_THEMES = {
      green: { hex: 0x00ff88, dark: 0x022c22, cssClass: '' },
      pink: { hex: 0xff007f, dark: 0x2c0218, cssClass: 'theme-pink' },
      cyan: { hex: 0x00f0ff, dark: 0x02232c, cssClass: 'theme-cyan' },
      amber: { hex: 0xffaa00, dark: 0x2c1a02, cssClass: 'theme-amber' },
      purple: { hex: 0xa855f7, dark: 0x1d022c, cssClass: 'theme-purple' }
    };

    function init3DBackground() {
      const container = document.getElementById('canvas-container');
      scene = new THREE.Scene();
      
      camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 4, 14);
      camera.lookAt(0, 0, 0);

      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      // Create 3D Perspective Grid
      gridHelper = new THREE.GridHelper(70, 40, currentThemeHex, currentThemeDarkHex);
      gridHelper.position.y = -3.5;
      scene.add(gridHelper);

      // Group holding dynamic 3D meshes
      active3DMeshGroup = new THREE.Group();
      scene.add(active3DMeshGroup);

      // Floating particles
      const particleCount = 280;
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);

      for (let i = 0; i < particleCount * 3; i += 3) {
        positions[i] = (Math.random() - 0.5) * 50;
        positions[i + 1] = (Math.random() - 0.5) * 35;
        positions[i + 2] = (Math.random() - 0.5) * 50;
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      const particleMaterial = new THREE.PointsMaterial({
        color: currentThemeHex,
        size: 0.18,
        transparent: true,
        opacity: 0.65
      });

      particles = new THREE.Points(geometry, particleMaterial);
      scene.add(particles);

      // Load active 3D mode mesh model
      set3DMode(current3DMode, false);

      // Parallax mouse effect
      let mouseX = 0, mouseY = 0;
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 0.5;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 0.5;
      });

      let clock = new THREE.Clock();

      function animate() {
        if (!is3DEnabled) return;
        animFrameId = requestAnimationFrame(animate);

        const elapsedTime = clock.getElapsedTime();

        // Move grid
        const gridSpeed = (current3DMode === 'warp') ? 0.12 : 0.035;
        gridHelper.position.z += gridSpeed;
        if (gridHelper.position.z > 1.75) gridHelper.position.z = 0;

        // Animate Active 3D Group Meshes
        if (active3DMeshGroup) {
          if (current3DMode === 'knot') {
            active3DMeshGroup.children.forEach((child, idx) => {
              child.rotation.x = elapsedTime * (idx === 0 ? 0.4 : -0.5);
              child.rotation.y = elapsedTime * (idx === 0 ? 0.6 : -0.7);
              child.position.y = Math.sin(elapsedTime * 1.5) * 0.3 + 0.5;
            });
          } else if (current3DMode === 'sphere') {
            active3DMeshGroup.children.forEach((child, idx) => {
              if (idx === 0) child.rotation.y = elapsedTime * 0.3;
              if (idx === 1) child.rotation.z = elapsedTime * 0.8;
              if (idx === 2) child.rotation.x = elapsedTime * 0.6;
            });
          } else if (current3DMode === 'cubes') {
            active3DMeshGroup.children.forEach((cube) => {
              cube.rotation.x += 0.01;
              cube.rotation.y += 0.015;
            });
          } else if (current3DMode === 'warp') {
            const tunnel = active3DMeshGroup.children[0];
            if (tunnel) tunnel.rotation.z = elapsedTime * 0.5;
          }
        }

        // Particle dynamics
        if (current3DMode === 'warp') {
          const posArr = particles.geometry.attributes.position.array;
          for (let i = 2; i < posArr.length; i += 3) {
            posArr[i] += 0.35;
            if (posArr[i] > 10) posArr[i] = -40;
          }
          particles.geometry.attributes.position.needsUpdate = true;
        } else {
          particles.rotation.y += 0.0015;
        }

        // Smooth camera tilt
        camera.position.x += (mouseX * 6 - camera.position.x) * 0.05;
        camera.position.y += (-mouseY * 4 + 4 - camera.position.y) * 0.05;
        camera.lookAt(0, 0, -2);

        renderer.render(scene, camera);
      }

      // Check reduce motion preference
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        is3DEnabled = false;
        container.style.display = 'none';
      } else {
        animate();
      }

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }

    function set3DMode(modeName, playSound = true) {
      if (playSound && typeof cyberAudio !== 'undefined') cyberAudio.playClick();
      current3DMode = modeName || 'knot';
      localStorage.setItem('all_ai_3d_mode', current3DMode);

      if (!active3DMeshGroup) return;

      // Clear existing children objects
      while (active3DMeshGroup.children.length > 0) {
        const obj = active3DMeshGroup.children[0];
        if (obj.geometry) obj.geometry.dispose();
        if (obj.material) obj.material.dispose();
        active3DMeshGroup.remove(obj);
      }

      const mat = new THREE.MeshBasicMaterial({
        color: currentThemeHex,
        wireframe: true,
        transparent: true,
        opacity: 0.35
      });

      if (current3DMode === 'knot') {
        const knotGeom = new THREE.TorusKnotGeometry(2.2, 0.6, 100, 16);
        const knot = new THREE.Mesh(knotGeom, mat);
        knot.position.set(0, 0.5, -5);
        active3DMeshGroup.add(knot);

        const innerGeom = new THREE.IcosahedronGeometry(1.2, 2);
        const innerMat = new THREE.MeshBasicMaterial({
          color: currentThemeHex,
          wireframe: true,
          transparent: true,
          opacity: 0.25
        });
        const innerWire = new THREE.Mesh(innerGeom, innerMat);
        innerWire.position.set(0, 0.5, -5);
        active3DMeshGroup.add(innerWire);

      } else if (current3DMode === 'sphere') {
        const sphereGeom = new THREE.IcosahedronGeometry(2.5, 3);
        const sphere = new THREE.Mesh(sphereGeom, mat);
        sphere.position.set(0, 0.5, -5);
        active3DMeshGroup.add(sphere);

        const ringGeom1 = new THREE.TorusGeometry(3.6, 0.05, 16, 100);
        const ring1 = new THREE.Mesh(ringGeom1, mat);
        ring1.rotation.x = Math.PI / 3;
        ring1.position.set(0, 0.5, -5);
        active3DMeshGroup.add(ring1);

        const ringGeom2 = new THREE.TorusGeometry(4.2, 0.05, 16, 100);
        const ring2 = new THREE.Mesh(ringGeom2, mat);
        ring2.rotation.y = Math.PI / 4;
        ring2.position.set(0, 0.5, -5);
        active3DMeshGroup.add(ring2);

      } else if (current3DMode === 'cubes') {
        const cubeGeom = new THREE.BoxGeometry(1.2, 1.2, 1.2);
        for (let i = 0; i < 10; i++) {
          const cubeMat = new THREE.MeshBasicMaterial({
            color: currentThemeHex,
            wireframe: true,
            transparent: true,
            opacity: 0.4
          });
          const cube = new THREE.Mesh(cubeGeom, cubeMat);
          const angle = (i / 10) * Math.PI * 2;
          const radius = 4.5;
          cube.position.set(
            Math.cos(angle) * radius,
            Math.sin(angle * 2) * 1.5 + 0.5,
            Math.sin(angle) * radius - 5
          );
          active3DMeshGroup.add(cube);
        }

      } else if (current3DMode === 'warp') {
        const tunnelGeom = new THREE.CylinderGeometry(4.5, 4.5, 25, 24, 12, true);
        const tunnelMat = new THREE.MeshBasicMaterial({
          color: currentThemeHex,
          wireframe: true,
          transparent: true,
          opacity: 0.25
        });
        const tunnel = new THREE.Mesh(tunnelGeom, tunnelMat);
        tunnel.rotation.x = Math.PI / 2;
        tunnel.position.set(0, 0, -10);
        active3DMeshGroup.add(tunnel);
      }

      const dd = document.getElementById('theme-dropdown');
      if (dd) dd.classList.add('hidden');
    }

    function update3DThemeColors(hex, darkHex) {
      currentThemeHex = hex;
      currentThemeDarkHex = darkHex;

      if (gridHelper && scene) {
        scene.remove(gridHelper);
        gridHelper = new THREE.GridHelper(70, 40, hex, darkHex);
        gridHelper.position.y = -3.5;
        scene.add(gridHelper);
      }

      if (particles) {
        particles.material.color.setHex(hex);
      }

      set3DMode(current3DMode, false);
    }

    // Web Audio API Synthesizer Sound Engine
    class CyberAudioEngine {
      constructor() {
        this.enabled = false;
        this.ctx = null;
      }

      initCtx() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) this.ctx = new AudioContext();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playClick() {
        if (!this.enabled) return;
        this.initCtx();
        if (!this.ctx) return;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, this.ctx.currentTime + 0.05);

        gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.05);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.05);
      }

      playSendMsg() {
        if (!this.enabled) return;
        this.initCtx();
        if (!this.ctx) return;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(440, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1200, this.ctx.currentTime + 0.12);

        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.12);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.12);
      }
    }

