                  <span>💻</span> <span>Bantu buat script HTML/CSS</span>
                </button>
                <button onclick="app.useSuggestion('🧠 Jelaskan cara kerja AI secara sederhana')" class="p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/40 hover:border-cyber-neon text-xs text-gray-200 hover:text-cyber-neon transition flex items-start space-x-2">
                  <span>🧠</span> <span>Penjelasan konsep AI</span>
                </button>
                <button onclick="app.useSuggestion('✍️ Tuliskan draf pesan WhatsApp promosi')" class="p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/40 hover:border-cyber-neon text-xs text-gray-200 hover:text-cyber-neon transition flex items-start space-x-2">
                  <span>✍️</span> <span>Draf pesan promosi WA</span>
                </button>
                <button onclick="app.useSuggestion('📚 Tips belajar matematika cepat')" class="p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/40 hover:border-cyber-neon text-xs text-gray-200 hover:text-cyber-neon transition flex items-start space-x-2">
                  <span>📚</span> <span>Tips belajar logika</span>
                </button>
              </div>
            </div>
          `;
          return;
        }

        container.innerHTML = chat.messages.map((msg, index) => {
          const isUser = msg.role === 'user';
          
          if (isUser) {
            return `
              <div class="flex justify-end mb-4">
                <div class="max-w-[85%] sm:max-w-[75%] rounded-2xl rounded-tr-none bg-emerald-900/40 border border-cyber-neon/40 p-3.5 text-sm text-white shadow-[0_0_15px_var(--cyber-glow)]">
                  <p class="whitespace-pre-wrap">${this.escapeHtml(msg.content)}</p>
                  <span class="block text-[10px] text-cyber-neon/70 text-right mt-1">${msg.time}</span>
                </div>
              </div>
            `;
          } else {
            const htmlContent = marked.parse(msg.content);
            return `
              <div class="flex justify-start mb-4">
                <div class="max-w-[90%] sm:max-w-[80%] rounded-2xl rounded-tl-none glass-card p-4 text-sm text-gray-100 border-emerald-800/50">
                  <div class="flex items-center space-x-2 mb-2 pb-2 border-b border-emerald-900/40">
                    <span class="font-bold text-xs text-cyber-neon">${this.config.aiName}</span>
                    <span class="text-[10px] text-gray-500">${msg.time}</span>
                  </div>
                  <div class="markdown-content text-xs sm:text-sm leading-relaxed">${htmlContent}</div>
                  
                  <div class="flex items-center space-x-3 mt-3 pt-2 border-t border-emerald-900/30 text-xs">
                    <button onclick="app.copyText(this, \`${this.escapeQuote(msg.content)}\`)" class="text-gray-400 hover:text-cyber-neon transition flex items-center space-x-1">
                      <i class="fa-regular fa-copy"></i>
                      <span>Copy</span>
                    </button>
                    <button onclick="app.regenerateResponse(${index})" class="text-gray-400 hover:text-cyber-neon transition flex items-center space-x-1">
                      <i class="fa-solid fa-arrows-rotate"></i>
                      <span>Regenerate</span>
                    </button>
                  </div>
                </div>
              </div>
            `;
          }
        }).join('');

        this.scrollToBottom();
        this.addCopyCodeButtons();
      }

      addCopyCodeButtons() {
        document.querySelectorAll('.markdown-content pre').forEach(pre => {
          if (pre.querySelector('.btn-copy-code')) return;
          const btn = document.createElement('button');
          btn.className = 'btn-copy-code absolute top-2 right-2 px-2 py-1 rounded bg-emerald-950 border border-cyber-neon/40 text-[10px] text-cyber-neon hover:bg-cyber-neon hover:text-black font-mono transition';
          btn.innerHTML = '<i class="fa-regular fa-copy mr-1"></i>COPY CODE';
          btn.onclick = () => {
            cyberAudio.playClick();
            const code = pre.querySelector('code')?.innerText || pre.innerText;
            navigator.clipboard.writeText(code).then(() => {
              btn.innerHTML = '<i class="fa-solid fa-check mr-1"></i>Copied ✓';
              setTimeout(() => {
                btn.innerHTML = '<i class="fa-regular fa-copy mr-1"></i>COPY CODE';
              }, 2000);
            });
          };
          pre.style.position = 'relative';
          pre.appendChild(btn);
        });
      }

      useSuggestion(text) {
        document.getElementById('chat-input').value = text;
        this.handleSendMessage();
      }

      handleKeyDown(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          this.handleSendMessage();
        }
      }

      async handleSendMessage(e) {
        if (e) e.preventDefault();
        const input = document.getElementById('chat-input');
        const text = input.value.trim();
        if (!text || this.isProcessing) return;

        cyberAudio.playSendMsg();

        input.value = '';
        input.style.height = 'auto';

        const chat = this.conversations.find(c => c.id === this.currentChatId);
        if (!chat) return;

        if (chat.messages.length === 0) {
          chat.title = text.slice(0, 24) + '...';
          this.renderHistoryList();
        }

        const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        // Add user message
        chat.messages.push({
          role: 'user',
          content: text,
          time: timeStr
        });

        this.renderCurrentMessages();
        this.saveConversations();

        await this.fetchAIResponse(chat);
      }

      async fetchAIResponse(chat) {
        this.isProcessing = true;
        this.showTypingIndicator(true);

        try {
          // Prepare conversation payload for Gemini API
          const formattedContents = chat.messages.map(m => ({
            role: m.role === 'user' ? 'user' : 'model',
            parts: [{ text: m.content }]
          }));

          const payload = {
            contents: formattedContents,
            systemInstruction: {
              parts: [{ text: this.config.systemPrompt }]
            }
          };

          const apiKey = this.config.apiKey || "";
          const modelName = this.config.aiModel || "gemini-3-flash-preview";
          const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;

          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await response.json();

          if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
            const aiText = data.candidates[0].content.parts[0].text;
            chat.messages.push({
              role: 'assistant',
              content: aiText,
              time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });
          } else {
            throw new Error('Response API tidak valid');
          }

        } catch (err) {
          console.error(err);
          chat.messages.push({
            role: 'assistant',
            content: '⚠️ AI sedang mengalami gangguan. Silakan coba lagi nanti atau periksa koneksi backend.',
            time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          });
        } finally {
          this.isProcessing = false;
          this.showTypingIndicator(false);
          this.renderCurrentMessages();
          this.saveConversations();
        }
      }

      async regenerateResponse(msgIndex) {
        cyberAudio.playClick();
        const chat = this.conversations.find(c => c.id === this.currentChatId);
        if (!chat || this.isProcessing) return;

        // Truncate messages back to the prompt
        chat.messages = chat.messages.slice(0, msgIndex);
        this.renderCurrentMessages();
        this.saveConversations();
        await this.fetchAIResponse(chat);
      }

      showTypingIndicator(show) {
        const indicator = document.getElementById('typing-indicator');
        if (indicator) {
          if (show) indicator.classList.remove('hidden');
          else indicator.classList.add('hidden');
        }
        this.scrollToBottom();
      }

      scrollToBottom() {
        const container = document.getElementById('messages-container');
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      }

      copyText(btn, text) {
        cyberAudio.playClick();
        navigator.clipboard.writeText(text).then(() => {
          const orig = btn.innerHTML;
          btn.innerHTML = '<i class="fa-solid fa-check text-cyber-neon"></i><span>Copied ✓</span>';
          setTimeout(() => { btn.innerHTML = orig; }, 2000);
        });
      }

      /* ADMIN AUTH & DASHBOARD LOGIC */
      openAdminAuthModal() {
        cyberAudio.playClick();
        const modal = document.getElementById('modal-admin-auth');
        const errDiv = document.getElementById('admin-auth-error');
        const pinInput = document.getElementById('admin-passcode');
        if (pinInput) pinInput.value = '';
        if (modal) modal.classList.remove('hidden');
        if (errDiv) errDiv.classList.add('hidden');
      }

      closeAdminAuthModal() {
        cyberAudio.playClick();
        const modal = document.getElementById('modal-admin-auth');
        const pinInput = document.getElementById('admin-passcode');
        if (pinInput) pinInput.value = '';
        if (modal) modal.classList.add('hidden');
      }

      verifyAdminPasscode() {
        cyberAudio.playClick();
        const pinInput = document.getElementById('admin-passcode');
        const input = pinInput ? pinInput.value : '';
        const errDiv = document.getElementById('admin-auth-error');

        // Langsung hapus jejak angka PIN dari input field
        if (pinInput) pinInput.value = '';

        if (input === this.adminPasscode) {
          this.closeAdminAuthModal();
          this.openAdminDashboard();
        } else {
          errDiv.textContent = "Passcode Admin salah. Silakan coba lagi.";
          errDiv.classList.remove('hidden');
        }
      }

      openAdminDashboard() {
        document.getElementById('modal-admin-dashboard').classList.remove('hidden');
      }

      closeAdminDashboard() {
        cyberAudio.playClick();
        document.getElementById('modal-admin-dashboard').classList.add('hidden');
      }

      switchAdminTab(tabName) {
        cyberAudio.playClick();
        ['overview', 'ai', 'profile', 'appearance', 'developer'].forEach(t => {
          const btn = document.getElementById(`tab-btn-${t}`);
          const content = document.getElementById(`admin-tab-${t}`);
          if (t === tabName) {
            btn.className = 'pb-2 border-b-2 border-cyber-neon text-cyber-neon px-1 whitespace-nowrap';
            content.classList.remove('hidden');
          } else {
            btn.className = 'pb-2 border-b-2 border-transparent text-gray-400 hover:text-cyber-neon px-1 whitespace-nowrap';
            content.classList.add('hidden');
          }
        });
      }

      saveAISettings() {
        cyberAudio.playClick();
        const newPass = document.getElementById('input-new-passcode').value.trim();
        if (newPass) {
          this.adminPasscode = newPass;
          this.config.adminPasscode = newPass;
          document.getElementById('input-new-passcode').value = '';
        }

        this.config.apiKey = document.getElementById('input-api-key').value;
        this.config.aiModel = document.getElementById('input-ai-model').value;
        this.config.systemPrompt = document.getElementById('input-system-prompt').value;
        this.saveConfig();
        alert("Pengaturan AI & Keamanan Berhasil Disimpan!");
      }

      saveProfileSettings() {
        cyberAudio.playClick();
        this.config.aiName = document.getElementById('input-ai-name').value;
        this.config.aiDesc = document.getElementById('input-ai-desc').value;
        this.config.aiAvatar = document.getElementById('input-ai-avatar').value;

        // Save Social Media Links
        this.config.socials = {
          whatsapp: document.getElementById('input-soc-wa').value,
          instagram: document.getElementById('input-soc-ig').value,
          telegram: document.getElementById('input-soc-tg').value,
          github: document.getElementById('input-soc-gh').value,
          tiktok: document.getElementById('input-soc-tt').value,
          website: document.getElementById('input-soc-web').value
        };

        this.saveConfig();

        // Update UI Header
        document.getElementById('header-name').textContent = this.config.aiName;
        document.getElementById('header-desc').textContent = this.config.aiDesc;
        document.getElementById('header-avatar').src = this.config.aiAvatar;
        
        const landingAvatar = document.getElementById('landing-avatar');
        if (landingAvatar) landingAvatar.src = this.config.aiAvatar;

        this.renderSocialLinks();
        this.renderCurrentMessages();
        alert("Profil AI & Social Media Berhasil Diperbarui!");
      }

      toggle3DBackground(enabled) {
        cyberAudio.playClick();
        is3DEnabled = enabled;
        const container = document.getElementById('canvas-container');
        container.style.display = enabled ? 'block' : 'none';
      }

      escapeHtml(str) {
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
      }

      escapeQuote(str) {
        return str.replace(/`/g, '\\`').replace(/\$/g, '\\$');
      }
    }

    // Initialize application on window load
    let app;
    window.onload = function () {
      init3DBackground();
      app = new ApplicationController();
    };
  </script>
</body>
</html>
